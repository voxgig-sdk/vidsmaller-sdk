              "pending",
              "uploading",
              "processing",
              "completed",
              "failed",
              "expired"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "eta_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "input_filename": {
            "type": "string"
          },
          "output_filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_size": {
            "type": "integer"
          },
          "output_size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "saved_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "saved_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "credits_charged": {
            "type": "integer"
          },
          "download_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "JobResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiEnvelope"
          },
          {
            "type": "object",
            "required": [
              "job"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "job": {
                "$ref": "#/components/schemas/VideoJob"
              }
            }
          }
        ]
      },
      "JobStatusResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JobResponse"
          },
          {
            "type": "object",
            "required": [
              "webhook"
            ],
            "properties": {
              "webhook": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "delivered_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "last_error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "WebhookEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created_at",
