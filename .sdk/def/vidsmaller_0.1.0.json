                  ],
                  "properties": {
                    "field": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              },
              "knownPlatforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
