            version: 2
          }
          m: "POST"
          o: "/api/v1/video/uploads"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "video"
            }
            {
              lit: "uploads"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.upload`"
          }
        }
      ]
    }
  }



